# =============================================================================
# Django Core Settings
# =============================================================================
# DEBUG=False refuses the placeholder SECRET_KEY below, so this file will not
# boot until you generate a unique key (scripts/init-production.sh).
SECRET_KEY=replace-with-a-unique-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Database Configuration
# =============================================================================
# Compose does not publish 5432. This URL is for a Postgres you run yourself.
# Inside Compose, the backend uses host "db" and POSTGRES_PASSWORD.
POSTGRES_PASSWORD=studio_password
DATABASE_URL=postgresql://studio_user:studio_password@localhost:5432/studiosync
# For SQLite (development only):
# DATABASE_URL=sqlite:///db.sqlite3

# Legacy database env vars (if not using DATABASE_URL):
DB_NAME=music_studio
DB_USER=studio_user
DB_PASSWORD=studio_password
# When DEBUG=False, studio_password is rejected. Set a unique password.
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT Settings
# =============================================================================
# ACCESS_TOKEN_LIFETIME=60  # minutes (optional, defaults to 60)
# REFRESH_TOKEN_LIFETIME=7  # days (optional, defaults to 7)

# =============================================================================
# File Storage (S3/MinIO/R2)
# =============================================================================
# For local MinIO:
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_BUCKET=music-studio

# For production S3/R2 (uncomment and configure):
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_ENDPOINT_URL=https://your-endpoint.r2.cloudflarestorage.com
# AWS_S3_USE_SSL=True

# =============================================================================
# Email Configuration
# =============================================================================
# Note: StudioSync uses database-configured email settings at runtime
# These are fallback defaults only
DEFAULT_FROM_EMAIL=noreply@studiosync.local

# =============================================================================
# SMS Configuration (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================================
# Payment Processing (Stripe)
# =============================================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Stream Chat Configuration
# =============================================================================
STREAM_API_KEY=
STREAM_API_SECRET=

# =============================================================================
# Seeding & Test Data
# =============================================================================
# For local development, these default to simple passwords
# For CI/production, set SEED_SECURE_MODE=true and provide secure passwords
SEED_SECURE_MODE=false
SEED_ADMIN_PASSWORD=admin123
SEED_TEACHER_PASSWORD=teacher123
SEED_STUDENT_PASSWORD=student123

# =============================================================================
# Frontend Configuration
# =============================================================================
# If developing remotely, change localhost to your remote server's IP address
# unless you are using SSH port forwarding.
NEXT_PUBLIC_API_URL=https://dev.studiosync.cc/api

# Backend uses this URL for password-reset, welcome, and Stripe return links.
# The request Origin header is never used. Set this to the real frontend origin.
FRONTEND_BASE_URL=https://studio.example.com

# Optional. When empty, the server prints a one-time setup token at boot.
# Send it as X-Setup-Token while finishing /setup. It is not returned by the API.
SETUP_TOKEN=

# Optional absolute origin for uploaded files, with no trailing slash.
# Point this at a host that only serves media, separate from the app.
MEDIA_BASE_URL=

# Set true behind HTTPS so session cookies are marked Secure.
IS_HTTPS=True
